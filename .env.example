# Server
NODE_ENV=production
APP_URL=https://factory.example.com
APP_DOMAIN=factory.example.com
# Set to true behind a reverse proxy / load balancer so client IPs are read from X-Forwarded-For
TRUST_PROXY=true

# PostgreSQL (required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cocoa_production
POSTGRES_USER=cocoa
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SSL=false
# Optional: keep the auth tables in their own schema instead of public
POSTGRES_SCHEMA=
PG_POOL_MAX=5

# Sessions (required in production, 32+ characters: npm run generate-secret)
SESSION_SECRET=your_32plus_character_secret_here
SESSION_COOKIE_NAME=cocoa.sid
SESSION_TTL_DAYS=30
SESSION_IDLE_MINUTES=720

# Passwords and sign-in limits
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=30
RECOVERY_MAX_REQUESTS=20

# First admin account, created by `npm run init-db` (must change password at first sign-in)
BOOTSTRAP_ADMIN_EMAIL=admin@your-company.com
BOOTSTRAP_ADMIN_PASSWORD=change_this_at_first_login
BOOTSTRAP_ADMIN_NAME=Factory Admin
# Demo accounts (password cocoa123) — never enable in production
SEED_DEMO_USERS=false

# Password-recovery email (SMTP). Leave SMTP_HOST empty in development to log codes to the console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Cocoa Factory <no-reply@your-company.com>

# Operations
SENTRY_DSN=
BACKUP_DIR=./backups
