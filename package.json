  },
  "dependencies": {
    "next": "15.5.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "^0.548.0",
    "tailwindcss": "^4.1.14",
    "@tailwindcss/postcss": "^4.1.14",
    "pg": "^8.23.0",
    "bcryptjs": "^3.0.3",
    "nodemailer": "^10.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^19.2.2",
    "@types/node": "^22.18.10",
    "@types/react-dom": "^19.2.2",
    "@types/pg": "^8.23.1",
    "@types/nodemailer": "^8.0.1",
    "@playwright/test": "^1.63.0"
  }
