{
  "name": "cocoa-production-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "init-db": "node scripts/init-db.mjs",
    "prune-sessions": "node scripts/prune-sessions.mjs",
